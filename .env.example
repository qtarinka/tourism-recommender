# Copy this file to .env and fill in real values.

# Leave unset to use the bundled SQLite database (data/app.db).
# For PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# Password for the admin panel (seasonal risk management). Change this.
ADMIN_PASSWORD=admin

# Link to your Power BI report (the normal app.powerbi.com report URL, or
# a Share link) for the GUS statistics dashboard. Rendered as a clickable
# "Open Power BI dashboard" button -- opening it requires being signed in
# to Power BI, so this works even when your tenant has "Publish to web"
# disabled (a common institutional restriction). Leave blank to hide it.
POWERBI_REPORT_URL=

# MSZ travel-warnings RSS feed URL. Leave blank to skip live MSZ refresh
# (existing/seed data is kept). See docs/DEVELOPMENT_DOCUMENTATION.md.
MSZ_RSS_URL=
